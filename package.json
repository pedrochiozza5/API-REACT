{
  "name": "bienamargos-bienyerbados-dual-store",
  "private": true,
  "version": "10.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node server.js",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:init",
    "import:world-map": "tsx scripts/import-world-map.ts",
    "setup:production": "npm run db:init",
    "setup:demo": "npm run db:init && npm run db:seed",
    "test": "tsx --test tests/*.test.ts",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.3.0",
    "@tanstack/react-query": "^5.90.5",
    "@tailwindcss/vite": "^4.1.14",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "lucide-react": "^0.546.0",
    "mysql2": "^3.15.3",
    "nanoid": "^5.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8",
    "@vitejs/plugin-react": "^5.0.4",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "motion": "^12.23.24",
    "embla-carousel-react": "^8.6.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "@fastify/rate-limit": "^10.3.0",
    "leaflet": "^1.9.4",
    "@types/leaflet": "^1.9.15"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "server.js"
}
